# ── Server ──────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ── Database (TimescaleDB / PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/vitalsync

# ── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Auth ────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_random_32_char_string_access
JWT_REFRESH_SECRET=change_me_to_a_random_32_char_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── ML Service ──────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── Email (SendGrid) ────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@vitalsync.app

# ── Web Push (VAPID) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_EMAIL=mailto:admin@vitalsync.app

# ── AI (Anthropic Claude) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ── Bull Queue ──────────────────────────────────────────────────
BULL_REDIS_URL=redis://localhost:6379
